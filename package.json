    "react-dom": "^19.1.1",
    "tinacms": "^3.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.3",
    "wrangler": "^4.162.0"
  }
